# Copy to .env and fill in the values before running ./docker-compose.sh up --detach
# Both values are required; Compose fails if either is empty.

# Email for the initial Open WebUI admin account.
# Only applied on first startup, before any user exists.
WEBUI_ADMIN_EMAIL=

# Password for the initial admin account. Use a strong, unique value.
# Change it later from the Open WebUI admin panel, not here.
WEBUI_ADMIN_PASSWORD=
